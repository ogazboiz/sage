# Sage mobile — environment variables
# Copy to .env.local and fill in.

# ElevenLabs Conversational Agent ID. Create one at
# https://elevenlabs.io/app/conversational-ai with these client tools wired up:
#   get_vault_status, find_yield, find_idle_assets, propose_bridge,
#   propose_deposit, propose_yield_deposit, pay_briefing, start_autonomous_task
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=

# Briefing service base URL. The autonomous loop hits /brief, /yield-snapshot,
# /alert-check, /synthesize, /market-pulse, /wrap-up here.
#  - 10.0.2.2 is the emulator's host-machine alias (so localhost on your Mac
#    becomes 10.0.2.2:3001 inside the emulator).
#  - For a deployed service, replace with the public URL (no trailing slash).
EXPO_PUBLIC_BRIEFING_URL=http://10.0.2.2:3001

# Sage briefing service — copy to .env.local for local dev, or set
# these in your Railway / Render / Fly dashboard for production.

# HTTP port. Railway sets this automatically.
PORT=3001

# Solana RPC. Devnet is fine for the demo flow; for mainnet swap to
# a paid provider URL.
RPC=https://api.devnet.solana.com

# Treasury that receives x402 settle transfers. Mint authority for
# SAGE-USDC was set up in scripts/airdrop-usdc.ts; treasury is the
# wallet that pubkey corresponds to.
TREASURY=HKDKTVqJYfwZwSXMZiFKHe75bykunBFQUZW5gv6frYvw

# SAGE-USDC mint. Same value used in app + mobile constants.
MINT=EzAYN6m9yDhwKHRdt9iY9LCgpPDdCXrUtmfoj7PWNYon

# LI.FI Earn API key. Required for /yield-snapshot, /alert-check,
# /synthesize and /brief — without it those endpoints fall back to
# unauthenticated reads (lower rate limit).
LIFI_API_KEY=

# Gemini API key. Required for the natural-language briefing prose
# (/brief, /synthesize, /wrap-up). Without it the responses fall back
# to deterministic stat dumps.
GEMINI_API_KEY=
